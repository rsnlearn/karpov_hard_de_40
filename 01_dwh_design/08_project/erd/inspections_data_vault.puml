@startuml name "inspection data vault"
' hide the spot
hide circle

left to right direction

' avoid problems with angled crows feet
skinparam linetype ortho

entity h_inspection {
    **PK inspection_sk**
    --
    **FK contract_sk**
    **FK supplier_sk**
    **FK consignee_sk**
    **FK item_sk**
    **FK order_part_sk**
}

entity s_inspection_plan {
    **PK inspection_sk**
    --
    plan_inspection_dt
    plan_arrival_dt
    load_dttm
    source_id
}

entity h_freicht {
    **PK inspection_sk**
    --
    **FK country_sk**
    **FK vehicle_sk**
    arrival_dttm
    load_dttm
    source_id
}

entity h_country {
    country_sk
    --
    country_iso_code
    country_name
    load_dttm
    source_id
}

entity l_freicht_country {
    inspection_sk
    country_sk
    --
    load_dttm
    source_id
}

entity h_vehicle {
    **PK vehicle_sk**
    --
    vehicle_code
    vehicle_name
    vehicle_type
    load_dttm
    source_id
}

entity l_freicht_vehicle {
    inspection_sk
    vehicle_sk
    --
    load_dttm
    source_id
}

entity h_container {
    container_sk
    --
    container_code
    container_size
    container_weight
    --
    load_dttm
    source_id
}

entity l_inspection_container {
    inspection_sk
    container_sk
    --
    load_dttm
    source_id
}

entity l_freicht_container {
    freicht_sk
    container_sk
    --
    load_dttm
    source_id
}

'entity s_inspection_sendout{
'    **PK inspection_sk**
'    --
'    sendout_dt
'    load_dttm
'    source_id
'}

entity l_container_item {
    container_sk
    item_sk
    --
    container_item_weight
    container_item_pack_qnty
    --
    load_dttm
    source_id
}

entity s_inspection_report {
    **PK inspection_sk**
    --
    container_num
    inspection_number
    inspection_dttm
    inspection_report_path
    inspection_type
    inspection_result
    inspection_cost
    category_a_perc
    category_b_perc
    category_c_perc
    category_d_perc
    surveyor_comment
    --
    load_dttm
    source_id
}

entity h_item {
    **PK item_sk**
    --
    **FK item_vendor_sk**
    **FK item_category_sk**
    --
    item_code
    item_barchar_code
    is_social
    is_food
    is_fresh
    is_excise
    --
    load_dttm
    source_id
}

entity h_location {
    **PK location_sk**
    --
    location_name
    location_type
    --
    load_dttm
    source_id
}

entity l_inspection_location{
    **PK inspection_sk**
    **PK location_sk**
    --
    load_dttm
    source_id
}

entity h_surveyor {
    **PK location_sk**
    --
    surveyor_name
    --
    load_dttm
    source_id
}

entity h_contract {
    **PK contract_sk**
    --
    contract_number
    contract_dt
    --
    load_dttm
    source_id
}

entity l_inspection_contract {
    **PK inspection_sk**
    **PK contract_sk**
    --
    load_dttm
    source_id
}

entity h_order {
    **PK order_sk**
    --
    order_num
    order_dt
    order_contract_num
    order_contract_dt
    supplier_name
    supplier_code
    --
    load_dttm
    source_id
}

entity l_order_item {
    PK order_sk
    PK item_sk
    --
    order_item_qnty
    order_item_price
    --
    load_dttm
    source_id
}

entity h_order_part {
    **PK order_part_sk**
    --
    **FK order_sk**
    --
    part_code : char(20)
    --
    load_dttm
    source_id
}

'entity fact_sorting {
'    **PK sorting_sk**
'    --
'    **FK inspection_sk**
'    --
'    contractor
'    contract_number
'    contract_dt
'    act_number
'    act_dt
'    load_location
'    sorting_amount
'    sorting_price
'    unit
'    price_per_unit
'    sorting_plan_dt
'    sorting_dt
'    sorting_report_path
'    contractor_comment
'    utilization_perc
'    return_perc
'    sorting_perc
'    acceptance_perc
'    return_qnty
'    utilization_qnty
'}

's_inspection_report ||..up[hidden]|| s_inspection_freicht
's_inspection_freicht ||..up[hidden]|| s_inspection_plan
's_inspection_freicht ||.up[hidden]|| s_inspection_sendout
's_inspection_report - h_inspection
's_inspection_freicht - h_inspection
's_inspection_plan - h_inspection
's_inspection_sendout- h_inspection
'h_location ||..[hidden]|| h_country
'h_surveyor ||..[hidden]|| h_item
'h_country ||.down[hidden]|| h_item
'h_location ||--o{ l_inspection_location
'l_inspection_location }o--|| h_inspection
'h_country ||--o{ l_inspection_country
'l_inspection_country }o--|| h_inspection
'h_item ||--o{ h_inspection
'h_surveyor ||--o{ h_inspection
'h_inspection }o--|| l_inspection_contract
'l_inspection_contract }o--|| h_contract
'h_inspection }o--|| h_order_part
'h_inspection }o--|| h_vehicle
'h_order_part }o--|| fact_order
'h_country ||.down[hidden]|| h_item
'h_inspection ||-o{fact_sorting

h_freicht -{ l_freicht_country
l_freicht_country }-left h_country

h_freicht --{ l_freicht_vehicle
l_freicht_vehicle }-- h_vehicle

h_freicht --{ l_freicht_container
l_freicht_container }-- h_container

h_inspection -{ l_inspection_container
l_inspection_container }- h_container

h_container -{ l_container_item
l_container_item }- h_item

h_order -{ l_order_item
l_order_item }- h_item

h_order --{ l_order_part
l_order_part }-- h_order_part

h_order_part --{ l_order_part_freicht
l_order_part_freicht }-- h_freicht

h_order --{ l_order_supplier
l_order_supplier }-- h_supplier

h_inspection -left{ l_inspection_surveyor
l_inspection_surveyor }-left h_surveyor

h_inspection --{ l_inspection_item
l_inspection_item }-- h_item

h_inspection --{ l_inspection_location
l_inspection_location }-- h_location

h_inspection --{ l_inspection_inspector
l_inspection_inspector }-- h_inspector

h_inspection --{ s_inspection_report

@enduml
